<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_natura_print_transfer_line_label_wizard_form" model="ir.ui.view">
        <field name="name">natura.print.transfer.line.label.wizard.form</field>
        <field name="model">natura.print.transfer.line.label.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Transfer Line Labels">
                <sheet>
                    <group>
                        <field name="move_id" readonly="1"/>
                        <field name="printer_id" required="1"/>
                        <field name="use_partner_config" readonly="1"/>
                    </group>
                    <group>
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="template_id"/>
                                <field name="source_model" readonly="1"/>
                                <field name="qty"/>
                                <button name="action_test_print" type="object" string="Test Print" class="btn-secondary"/>
                                <button name="action_print_all" type="object" string="Print All" class="btn-primary"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_natura_print_transfer_line_label_wizard" model="ir.actions.act_window">
        <field name="name">Print Transfer Line Labels</field>
        <field name="res_model">natura.print.transfer.line.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
