<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_natura_print_label_template_type_tree" model="ir.ui.view">
        <field name="name">natura.print.label.template.type.tree</field>
        <field name="model">natura.print.label.template.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_natura_print_label_template_type_form" model="ir.ui.view">
        <field name="name">natura.print.label.template.type.form</field>
        <field name="model">natura.print.label.template.type</field>
        <field name="arch" type="xml">
            <form string="Template Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_natura_print_label_template_type" model="ir.actions.act_window">
        <field name="name">Template Types</field>
        <field name="res_model">natura.print.label.template.type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
