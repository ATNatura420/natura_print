<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_view_inherit_natura_print" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.natura.print</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='product_id']" position="after">
                <button name="action_natura_print_line_labels" type="object" string="Print" icon="fa-print"
                    invisible="not product_id"/>
            </xpath>
        </field>
    </record>
</odoo>
