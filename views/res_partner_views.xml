<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_form_view_inherit_natura_print" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.natura.print</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="natura_print_label_config_required" invisible="company_type != 'company'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Label Templates" name="natura_print_label_templates"
                    invisible="not natura_print_label_config_required or company_type != 'company'">
                    <field name="natura_print_label_line_ids">
                        <tree editable="bottom">
                            <field name="model_id"/>
                            <field name="template_id"/>
                            <field name="qty_multiplier"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
