<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_inherit_natura_print" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.natura.print</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='price_subtotal']" position="after">
                <button name="action_natura_print_line_labels" type="object" string="Print"
                    icon="fa-print" invisible="display_type or not product_id"/>
            </xpath>
        </field>
    </record>
</odoo>
