<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_view_inherit_natura_print" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.natura.print</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']" position="after">
                <page string="Label Templates" name="natura_print_label_templates">
                    <field name="natura_print_label_line_ids">
                        <tree editable="bottom">
                            <field name="template_id"/>
                            <field name="qty_multiplier"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
